# npm 12 changed the default of `allow-git` to "none". A project pinning a git
# dependency then fails to install at all, with:
#
#   npm error code EALLOWGIT
#   npm error Fetching packages of type "git" have been disabled
#
# This repo pins @kwpledger/design as a git dependency deliberately — consumers
# take a pinned git dep rather than a runtime <link> so one bad deploy cannot
# strip styling from every property at once.
#
# "root", NOT "all": this permits the git dependencies THIS package.json
# declares, while still refusing transitive git deps pulled in by third-party
# packages — the supply-chain risk npm actually hardened against. "all" would
# reopen the whole hole to fix one line.
#
# Tracked on purpose. A local .npmrc fixes one machine; this covers every
# machine and every CI runner, including the ones that npm-install on merge.
allow-git=root
